# Copy to .env and edit. `make serve` and `make e1` export these; nothing else reads .env.
# Never commit .env.

# Bind address and port for `discoverylab serve`. A non-loopback host requires DISCOVERYLAB_API_TOKEN.
DISCOVERYLAB_HOST=127.0.0.1
DISCOVERYLAB_PORT=8000

# Bearer token. When set, every /api route except /api/health needs it. Posting a reviewer's
# corrections always needs it. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCOVERYLAB_API_TOKEN=

# Requests per second per client before the API answers 429.
DISCOVERYLAB_RATE_PER_SEC=30

# Contact address sent to OpenAlex and Crossref (their "polite pool"). Optional.
DISCOVERYLAB_MAILTO=

# Model for the language-model reasoner, critic and judges.
DISCOVERYLAB_MODEL=claude-opus-5-5

# Needed only for language-model runs and judges. Leave empty to run the rule baseline.
ANTHROPIC_API_KEY=

# Local open-weights models (no API key; `make models` downloads both into models/, D17).
# Reasoner and model critic: Qwen3-4B-Instruct-2507 (Apache-2.0). Judges: Phi-4-mini-instruct (MIT).
DISCOVERYLAB_LOCAL_MODEL=models/qwen3-4b-instruct-2507-q4_0.gguf
DISCOVERYLAB_LOCAL_JUDGE=models/phi-4-mini-instruct-q4_k_m.gguf
# CPU threads for llama.cpp (defaults to every core).
DISCOVERYLAB_LOCAL_THREADS=
